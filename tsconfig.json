{
  "compilerOptions": {
    "target": "es5",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "noEmit": false,
    "jsx": "react",
    "ignoreDeprecations": "6.0" // temp fix, if extension breaks upon TypeScript 7.0 release, remove this line and fix the deprecation warnings
  },
  "include": ["src"],
  "exclude": ["build", "node_modules"]
}
